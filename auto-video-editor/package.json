{
  "name": "dau-anh-auto-video-editor",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/main.js",
  "description": "Local Windows study-abroad video editor",
  "author": "Dau Anh AI",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node --import tsx scripts/build-remotion.mts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win --x64",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/captions": "4.0.530",
    "@remotion/media": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@remotion/transitions": "4.0.530",
    "chokidar": "^4.0.3",
    "fontkit": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.530",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/fontkit": "^2.0.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
